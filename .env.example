# Connectly Environment Variables Configuration
# Copy this file to .env and set secure values for production

# Secret key for session management and CSRF protection
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database URL (defaults to SQLite if unset)
# DATABASE_URL=sqlite:///instance/contacts.db
# Or PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/connectly

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

